<?xml version="1.0" encoding="utf-8"?>
<!-- O token do celular não vai para o backup na nuvem nem para outro aparelho na troca de celular. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
